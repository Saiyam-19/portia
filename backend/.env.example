# Copy to backend/.env. Never place server secrets in NEXT_PUBLIC_* variables.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Chat aliases are mapped privately in models.py; paid routing must be enabled.
LLM_ALLOW_PAID=true
LLM_MAX_TOKENS=4096
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional; defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Optional; when absent the agent asks for vessel particulars manually.
VESSEL_API_KEY=
ALLOWED_ORIGINS=http://localhost:3001

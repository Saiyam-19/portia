      "notes": [
        {
          "text": "BPTS issue 3 revision 14 applies from 1 October 2026; the fuel surcharge on pilotage of USD 0.225070 per GT applies from the same date.",
          "source": {
            "document": "bpts-rev14-2026-10",
            "page": 1
          }
        },
        {
          "text": "Container ships' environment protection charge is per container and is charged by the container terminal to the container operating agent, so it is not added to vessel estimates.",
          "source": {
            "document": "bpts-rev14-2026-10",
            "page": 28,
            "section": "IV.E"
          }
        },
        {
          "text": "Additional pilotage by ship age is suspended from 1 April 2023 until further notice.",
          "source": {
            "document": "bpts-rev14-2026-10",
            "page": 27,
            "section": "IV.B (iii)"
          }
        },
        {
          "text": "The tariff is in US dollars for all ships; there are no separate coastal rates.",
          "source": {
            "document": "bpts-rev14-2026-10",
            "page": 26
          }
        },
        {
          "text": "LNG and LPG/chemical carriers are treated as tankers for berth hire ('Tankers' includes liquefied gases in the definitions). Berth hire is printed per GRT per hour without 'or part thereof', so exact hours are used; the US$ 900 minimum is per day, each started day counting as a full day (definition of 'Per day')."
        }
      ],
      "notPriced": []
    }
  ]
}

# Next.js runtime. Copy to .env.local; never commit real secrets.
PORTIA_ENABLED=false
PORTIA_CONVEX_DEPLOYMENT=brilliant-whale-380
NEXT_PUBLIC_CONVEX_URL=https://brilliant-whale-380.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://brilliant-whale-380.convex.site
SITE_URL=http://127.0.0.1:3002
# Set the same mode in Convex: private (allowlisted) or basic (fresh signup).
# Basic mode intentionally does not verify email. No email recovery is configured.
PORTIA_AUTH_MODE=private
PORTIA_SERVER_SECRET=
OPENROUTER_API_KEY=
# Optional: openai/gpt-6-sol for final checks; the default is openai/gpt-6-luna.
# BERTHWISE_MODEL=openai/gpt-6-luna
LLM_ALLOW_PAID=true
# Convex also needs PORTIA_ENABLED, PORTIA_CONVEX_DEPLOYMENT, PORTIA_AUTH_MODE,
# SITE_URL, PORTIA_SERVER_SECRET, and BETTER_AUTH_SECRET (server-only).
# Private mode only: MIGRATION_ALLOWED_EMAILS=first@example.com,second@example.com
# Bounded per-user rolling limits (Convex env); defaults shown.
# PORTIA_RUNS_PER_MINUTE=8
# PORTIA_RUNS_PER_HOUR=60
# PORTIA_CREATES_PER_MINUTE=6
# PORTIA_CREATES_PER_HOUR=30

# Cross-chat memory and working notes; set in both Next.js and Convex.
PORTIA_MEMORY_ENABLED=false
# Explicit loopback-only local verification, never a cloud target override.
PORTIA_LOCAL_BACKEND=false
